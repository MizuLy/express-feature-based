DATABASE_URL=           # Prisma connection string (postgres://user:pass@host:port/db)

FRONTEND_URL=           # Your client app's origin, used for the CORS whitelist
PORT=                   # Port your Express server listens on (e.g. 5000)
NODE_ENV=               # development | production | test

JWT_SECRET=             # Signing secret for JWT tokens
JWT_EXPIRES_IN=         # Token lifespan, e.g. "1d"

CLOUDINARY_CLOUD_NAME=  # Only needed if you add uploads
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=          # Auth key for sending emails via Brevo
BREVO_SENDER_EMAIL=     # "From" address used when sending emails
BREVO_SENDER_NAME=      # "From" name, e.g. "APDO Scheduling"